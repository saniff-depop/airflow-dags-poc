# Copy to docker/.env and edit for your machine. Do not commit docker/.env.
#
#   cp docker/.env.example docker/.env
#
# Variable names align with specs/initial-setup/README.md (MySQL metadata, two Postgres roles).

# -----------------------------------------------------------------------------
# Airflow UID — file ownership on Linux for mounted volumes (logs, dags, etc.)
# On Linux, match your host user: `id -u`. macOS Docker Desktop often works with 50000;
# see https://airflow.apache.org/docs/apache-airflow/stable/howto/docker-compose/index.html
# -----------------------------------------------------------------------------
AIRFLOW_UID=50000

# -----------------------------------------------------------------------------
# Airflow metadata database (MySQL only — not source/warehouse Postgres)
# Host must match the MySQL service name in docker/docker-compose.yaml (mysql_airflow).
# Uses PyMySQL (installed in docker/Dockerfile.airflow). Password must match MYSQL_PASSWORD.
# -----------------------------------------------------------------------------
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=mysql+pymysql://airflow:changeme_airflow@mysql_airflow:3306/airflow

# -----------------------------------------------------------------------------
# Fernet key for encrypting connections in the metadata DB (generate for production)
# openssl rand -base64 32
# If unset, docker-compose.yaml supplies a non-production default for local dev only.
# -----------------------------------------------------------------------------
# AIRFLOW__CORE__FERNET_KEY=

# -----------------------------------------------------------------------------
# Airflow UI (first-time login after airflow-init)
# -----------------------------------------------------------------------------
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_WEBSERVER_PORT=8080

# -----------------------------------------------------------------------------
# Optional: pin base / built image tags (see docker/Dockerfile.airflow)
# -----------------------------------------------------------------------------
# AIRFLOW_BASE_IMAGE=apache/airflow:2.10.5-python3.12
# AIRFLOW_IMAGE_NAME=airflow-dags-poc-airflow:2.10.5

# -----------------------------------------------------------------------------
# MySQL service — dedicated Airflow metadata instance
# Host port for GUI clients (DBeaver, etc.); Airflow containers use mysql_airflow:3306 internally.
# -----------------------------------------------------------------------------
MYSQL_AIRFLOW_PORT=3307
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=airflow
MYSQL_USER=airflow
MYSQL_PASSWORD=changeme_airflow

# -----------------------------------------------------------------------------
# PostgreSQL — source (operational / upstream)
# -----------------------------------------------------------------------------
POSTGRES_SOURCE_USER=source_user
POSTGRES_SOURCE_PASSWORD=changeme_source
POSTGRES_SOURCE_DB=source_db
POSTGRES_SOURCE_PORT=5433

# -----------------------------------------------------------------------------
# PostgreSQL — data warehouse
# -----------------------------------------------------------------------------
POSTGRES_WAREHOUSE_USER=warehouse_user
POSTGRES_WAREHOUSE_PASSWORD=changeme_warehouse
POSTGRES_WAREHOUSE_DB=warehouse_db
POSTGRES_WAREHOUSE_PORT=5434
